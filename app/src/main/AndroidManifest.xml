<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- USB printers are optional: required here would hide the app on Google Play from devices without USB host. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Lets the lock setup guide see the other Home apps, so it can tell whether the kiosk is the default one
         (without this, package visibility hides them and the kiosk always looks like the only Home app). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Print services of all-in-one POS devices. The Sunmi SDK declares only its main service
             (woyou.aidlservice.jiuiv5) itself; this one drives the K2 kiosk's printer. -->
        <package android:name="com.sunmi.extprinterservice" />
        <package android:name="com.imin.printerservice" />
    </queries>

    <application
        android:name=".KioskApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kiosk"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- With this filter Android offers "always" in its USB prompt, and then grants the printer on every attach
             without asking: the prompt itself can't open over a pinned app. It stays off until the app knows there is
             no printer inside the device (BuiltInPrinterModule), because a Sunmi or iMin printer can be a USB printer
             too, and the filter would put a prompt about it in front of customers. -->
        <activity-alias
            android:name=".UsbPrinterAttached"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_printer_filter" />
        </activity-alias>

        <!-- Enables Lock Task Mode once provisioned with:
             adb shell dpm set-device-owner com.pos.kiosk/.KioskDeviceAdminReceiver -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Persists AppCompatDelegate.setApplicationLocales on API < 33. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
