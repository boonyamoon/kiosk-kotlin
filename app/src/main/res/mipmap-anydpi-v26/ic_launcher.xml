<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground is the full round MeeD icon; its orange matches the background, so any launcher mask
     (circle, squircle, rounded square) shows a seamless orange tile. The inset keeps the awning
     corners inside the 66dp safe zone. Monochrome = the M + awning silhouette for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="8%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/ic_launcher_monochrome"
            android:inset="8%" />
    </monochrome>
</adaptive-icon>
